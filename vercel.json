{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{tests/**,.agents/**,flywheel_audit.jsonl,archive/**}"
    },
    "app.py": {
      "maxDuration": 15,
      "excludeFiles": "{tests/**,.agents/**,flywheel_audit.jsonl,archive/**}"
    }
  }
}
